{
  "id": "flat-d3d11-preflight",
  "scope": "classic-oblivion-flat-only",
  "view_count": 1,
  "pipeline": "Oblivion.exe (x86/D3D9) -> dgVoodoo D3D11 -> ReShade x86 -> Lumenite Kernel -> DLSS5 Feed transport-only -> addon32 -> host64",
  "settings": {
    "resolution": "1920x1080",
    "window_mode": "windowed",
    "display_output": "SDR",
    "work_resolution_percent": 100,
    "async_home": 0,
    "msaa": false,
    "ssaa": false,
    "frame_generation": false,
    "smooth_motion": false,
    "host_jitter": [
      0,
      0
    ]
  },
